# Aurivon Configuration

# TMDB API Key (get one free at https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Logging level (trace, debug, info, warn, error)
RUST_LOG=info

# MPV executable path (defaults to "mpv" if not set)
# MPV_PATH=/usr/bin/mpv

# Real-Debrid API key (optional, cached torrents over HTTPS)
# REAL_DEBRID_API_KEY=

# Trakt API app (https://trakt.tv/oauth/applications, redirect urn:ietf:wg:oauth:2.0:oob)
# TRAKT_CLIENT_ID=
# TRAKT_CLIENT_SECRET=

# Keep native Wayland (disables in-app video; mpv uses its own window)
# RMH_FORCE_WAYLAND=1

# OpenSubtitles (https://www.opensubtitles.com/consumers); account optional
# OPENSUBTITLES_API_KEY=
# OPENSUBTITLES_USERNAME=
# OPENSUBTITLES_PASSWORD=

# Simkl (https://simkl.com/settings/developer/)
# SIMKL_CLIENT_ID=

# AniList (https://anilist.co/settings/developer, redirect https://anilist.co/api/v2/oauth/pin)
# ANILIST_CLIENT_ID=
