# Aurivon configuration (copy to .env for development, or ~/.config/aurivon/.env when installed)

# TMDB API key (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Logging (trace, debug, info, warn, error)
RUST_LOG=info

# mpv executable (defaults to "mpv" on PATH)
# MPV_PATH=/usr/bin/mpv

# Real-Debrid (optional, cached torrents over HTTPS)
# REAL_DEBRID_API_KEY=

# Optional extra debrid providers
# TORBOX_API_KEY=
# ALLDEBRID_API_KEY=

# Trakt — Aurivon ships a built-in public client id (PKCE; no secret).
# Optional override if you use your own API app (same redirect URI required):
# TRAKT_CLIENT_ID=

# Keep native Wayland (disables in-app video; mpv uses its own window)
# AURIVON_FORCE_WAYLAND=1

# OpenSubtitles (https://www.opensubtitles.com/consumers); account optional
# OPENSUBTITLES_API_KEY=
# OPENSUBTITLES_USERNAME=
# OPENSUBTITLES_PASSWORD=

# Simkl (https://simkl.com/settings/developer/)
# SIMKL_CLIENT_ID=

# AniList (https://anilist.co/settings/developer, redirect https://anilist.co/api/v2/oauth/pin)
# ANILIST_CLIENT_ID=
